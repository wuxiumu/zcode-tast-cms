# ============================================
# 素材库后端 · 生产环境配置模板
# 部署到服务器后：复制为 backend/.env 并按需修改
# ============================================

# 资源完整地址（图片/视频/截图出参拼接的域名）
# 当前资源与 API 同域（nginx 直出 /uploads/）；接入 OSS 后改成 OSS 域名即可，历史数据零迁移
ASSET_BASE_URL=https://sucaiku-api.chiguashentan.com

# 跨域（CORS）不在 PHP 处理：在宝塔面板「网站设置 → 配置文件」按 deploy/nginx.conf 的跨域片段添加
# 提示：宝塔自带的「跨域」开关默认 Access-Control-Allow-Origin: *，生产建议改为指定前端域名

# 生产环境关闭调试（错误信息不再返回细节）
APP_DEBUG=0
