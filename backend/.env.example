# 后端部署配置（复制为 .env 后修改；系统环境变量优先于本文件）

# 资源访问域名（图片/视频/截图出参拼接的完整地址）。留空 = 同源相对路径（本地开发直连模式）。
# 生产示例：https://api.example.com ；接入 OSS 后改为 OSS 域名即可，历史数据无需迁移。
ASSET_BASE_URL=

# 跨域（CORS）不在 PHP 处理，由 Nginx/宝塔配置（见 deploy/nginx.conf 的跨域片段）

# JWT（生产务必改掉）
JWT_SECRET=change-me-before-production

# 管理端登录：用户名 + password_hash（bcrypt）
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=

# 模拟短信验证码（接真实短信前；生产请留空并接短信网关）
MOCK_SMS_CODE=
